<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <include layout="@layout/aurora" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingTop="22dp"
        android:paddingRight="40dp"
        android:paddingBottom="20dp">

        <include layout="@layout/top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cats"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="20dp"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chans"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="20dp"
                android:scrollbars="none" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/preview_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/focus_ring_big">

                    <ImageView
                        android:id="@+id/previewSky"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/skyline" />

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/previewVideo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        app:resize_mode="fit"
                        app:shutter_background_color="#00000000"
                        app:surface_type="texture_view"
                        app:use_controller="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_shade" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/live_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="9dp"
                        android:paddingTop="4dp"
                        android:paddingRight="9dp"
                        android:paddingBottom="4dp">

                        <View
                            android:id="@+id/liveDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_live" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="APERÇU"
                            android:textColor="@color/text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/previewLoading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/cyan"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pvChannel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Choisis une chaîne"
                            android:textColor="@color/cyan_light"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/pvTitle"
                            style="@style/H1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:id="@+id/pvTimes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="invisible">

                            <TextView
                                android:id="@+id/pvStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text2"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/pvProg"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progressDrawable="@drawable/progress_line" />

                            <TextView
                                android:id="@+id/pvEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text2"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/H1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ensuite"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/next1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/next2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="OK : plein écran  ·  Appui long / Menu : favori"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
