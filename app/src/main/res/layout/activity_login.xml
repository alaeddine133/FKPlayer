<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <include layout="@layout/aurora" />

    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="FK PLAYER"
            android:src="@drawable/ic_logo" />

        <TextView
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.12"
            android:text="FK PLAYER"
            android:textSize="34sp" />

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="22dp"
            android:indeterminateTint="@color/cyan" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chargement…"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="FK PLAYER"
                        android:src="@drawable/ic_logo" />

                    <TextView
                        style="@style/H1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:letterSpacing="0.1"
                        android:text="FK PLAYER"
                        android:textSize="28sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/qrBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/dialog_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/qr"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:background="@android:color/white"
                        android:contentDescription="QR code de connexion"
                        android:padding="6dp" />

                    <LinearLayout
                        android:layout_width="190dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/H1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avec ton téléphone"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="1. Connecte-le au même Wi-Fi\n2. Scanne le QR code\n3. Tape tes codes et envoie"
                            android:textColor="@color/text2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/qrUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/cyan"
                            android:textIsSelectable="false"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ou saisis tes codes avec la télécommande →"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="380dp"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_bg"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabXtream"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_toggle"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Xtream Codes"
                        android:textColor="@color/btn_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tabM3u"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_toggle"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Lien M3U"
                        android:textColor="@color/btn_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/server"
                    style="@style/Field"
                    android:layout_marginTop="16dp"
                    android:hint="Serveur  (http://exemple.com:8080)"
                    android:imeOptions="actionNext"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/user"
                    style="@style/Field"
                    android:hint="Nom d'utilisateur"
                    android:imeOptions="actionNext"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/pass"
                    style="@style/Field"
                    android:hint="Mot de passe"
                    android:imeOptions="actionDone"
                    android:inputType="textVisiblePassword" />

                <EditText
                    android:id="@+id/m3u"
                    style="@style/Field"
                    android:layout_marginTop="16dp"
                    android:hint="Lien M3U (http://…)"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/connect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/btn_primary"
                    android:focusable="true"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Se connecter"
                    android:textColor="@color/btn_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#FDA4AF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
