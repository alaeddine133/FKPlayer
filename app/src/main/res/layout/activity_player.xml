<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/cyan" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/live_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/zap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_margin="28dp"
        android:background="@drawable/zap_bg"
        android:fontFamily="sans-serif-black"
        android:minWidth="90dp"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text"
        android:textSize="34sp"
        android:visibility="gone" />

    <!-- Bandeau du haut -->
    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shade_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="36dp"
        android:paddingTop="20dp"
        android:paddingRight="36dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/topTitle"
            style="@style/H1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/optionsBtn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="14dp"
            android:background="@drawable/btn_toggle"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Options"
            android:textColor="@color/btn_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E4E1F0"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bandeau du bas -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom"
        android:orientation="vertical"
        android:paddingLeft="36dp"
        android:paddingTop="50dp"
        android:paddingRight="36dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/logoBox"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/logo_bg">

                <TextView
                    android:id="@+id/logoIni"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/cyan_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/title"
                    style="@style/H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tech"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/prog"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/progress_line" />

            <TextView
                android:id="@+id/tEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Boutons films / séries : ▼ pour y aller, ◀▶ pour choisir, OK pour valider -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/btnRew" style="@style/PlayerBtn" android:text="◀◀  Retour rapide" />
            <TextView android:id="@+id/btnBack10" style="@style/PlayerBtn" android:text="−10 s" />
            <TextView android:id="@+id/btnPlay" style="@style/PlayerBtn" android:text="❚❚  Pause" />
            <TextView android:id="@+id/btnFwd10" style="@style/PlayerBtn" android:text="+10 s" />
            <TextView android:id="@+id/btnFf" style="@style/PlayerBtn" android:text="Avance rapide  ▶▶" />
        </LinearLayout>

        <TextView
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Direct : OK ouvre les bouquets et leurs chaînes sans quitter le plein écran -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/panel_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="36dp"
        android:paddingTop="26dp"
        android:paddingRight="90dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panelTitle"
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Bouquets"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="▲▼ choisir  ·  ◀▶ bouquets / chaînes  ·  OK regarder  ·  Retour fermer"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelCats"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelChans"
                android:layout_width="360dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="14dp"
                android:clipToPadding="false"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
