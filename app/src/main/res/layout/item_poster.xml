<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/poster_ph"
        android:focusable="true"
        android:foreground="@drawable/focus_ring_poster">

        <TextView
            android:id="@+id/ini"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <com.fk.player.RatioImageView
            android:id="@+id/img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|top"
            android:layout_margin="5dp"
            android:background="@drawable/live_chip"
            android:paddingLeft="5dp"
            android:paddingTop="1dp"
            android:paddingRight="5dp"
            android:paddingBottom="1dp"
            android:textColor="#FACC15"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/fav"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="left|top"
            android:layout_margin="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/resume"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_margin="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_line"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#E4E1F0"
        android:textSize="11sp" />
</LinearLayout>
